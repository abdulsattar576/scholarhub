datasource db {
  provider = "postgresql"
  url      = env("APPLICATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/application-client"
}

enum ApplicationState {
  PLANNING
  PREPARING
  READY
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  scholarshipId   String            @map("scholarship_id")
  scholarshipTitle String           @map("scholarship_title")
  providerName    String            @map("provider_name")
  cycleLabel      String?           @map("cycle_label")
  targetDeadline  DateTime?         @map("target_deadline")
  status          ApplicationState  @default(PLANNING)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  documents       ApplicationDocument[]

  @@unique([userId, scholarshipId])
  @@map("applications")
}

model ApplicationDocument {
  id                  String      @id @default(uuid())
  applicationId       String      @map("application_id")
  documentType        String      @map("document_type")
  requirementLevel    String      @default("MANDATORY") @map("requirement_level")
  isPrepared          Boolean     @default(false) @map("is_prepared")
  attestationDone     Boolean     @default(false) @map("attestation_done")
  translationDone     Boolean     @default(false) @map("translation_done")
  instructions        String?
  notes               String?
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BackgroundJob {
  id             String     @id @default(uuid())
  jobType        String     @map("job_type")
  ownerUserId    String?    @map("owner_user_id")
  entityId       String?    @map("entity_id")
  status         JobStatus  @default(QUEUED)
  idempotencyKey String?    @unique @map("idempotency_key")
  attempts       Int        @default(0)
  maxAttempts    Int        @default(3) @map("max_attempts")
  progress       Int        @default(0)
  payload        Json?
  result         Json?
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  completedAt    DateTime?  @map("completed_at")

  @@index([status, createdAt])
  @@index([ownerUserId, status])
  @@map("background_jobs")
}

enum NotificationType {
  DEADLINE_REMINDER
  CYCLE_CLOSED
  CYCLE_REOPENED
  DOCUMENT_CHECKLIST_UPDATE
  SYSTEM_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id         String               @id @default(uuid())
  userId     String               @map("user_id")
  title      String
  message    String
  type       NotificationType     @default(SYSTEM_ANNOUNCEMENT)
  priority   NotificationPriority @default(NORMAL)
  isRead     Boolean              @default(false) @map("is_read")
  link       String?
  dedupKey   String?              @unique @map("dedup_key")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}


