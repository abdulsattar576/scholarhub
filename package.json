{
  "name": "scholarship-saas-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Scholarship SaaS — Service-Oriented Architecture Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm --prefix apps/api-gateway run start:dev",
    "dev:scholarship": "npm --prefix apps/scholarship-service run start:dev",
    "dev:worker": "npm --prefix apps/worker run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}

