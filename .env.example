# ==============================================================================
# Scholarship SaaS — Master Environment Configuration Contract (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development

# Exposed Ports
WEB_PORT=3000
API_GATEWAY_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Credentials (Root & Logical Databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity_secret
SCHOLARSHIP_DB_PASSWORD=scholarship_secret
APPLICATION_DB_PASSWORD=application_secret

# Database Connection URLs for Microservices
IDENTITY_DATABASE_URL=postgresql://identity_user:identity_secret@localhost:5432/identity_db?schema=public
SCHOLARSHIP_DATABASE_URL=postgresql://scholarship_user:scholarship_secret@localhost:5432/scholarship_db?schema=public
APPLICATION_DATABASE_URL=postgresql://application_user:application_secret@localhost:5432/application_db?schema=public

# Redis Broker Configuration
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# Internal Microservice gRPC Endpoints
SCHOLARSHIP_GRPC_URL=localhost:50051
CRAWLER_GRPC_URL=localhost:50052

# Authentication & Security
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# AI Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

